{
  "title": "Vault Overview",
  "schemaVersion": 37,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Vault Sealed",
      "targets": [
        {
          "expr": "vault_core_unsealed"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Vault Request Rate",
      "targets": [
        {
          "expr": "rate(vault_core_handle_request_count[1m])"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Vault Latency",
      "targets": [
        {
          "expr": "vault_core_handle_request{quantile=\"0.99\"}"
        }
      ]
    }
  ]
}