name: tests-e2e-ui-ci

on:
  push:
    paths:
      - "tests/e2e-ui/**"
      - ".github/workflows/ci-tests-e2e-ui.yml"
  pull_request:
    paths:
      - "tests/e2e-ui/**"

permissions:
  contents: read
  id-token: write
  packages: write
  security-events: write

jobs:

  code-quality:
    name: Code Quality (Flake8 + Black + Isort + Mypy)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3

      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: 3.11

      - name: Install linters
        run: pip install flake8 black isort mypy

      - name: Run Flake8
        run: flake8 app/backend tests/e2e-ui

      - name: Run Black
        run: black --check app/backend tests/e2e-ui

      - name: Run Isort
        run: isort --check-only app/backend tests/e2e-ui

      - name: Run Mypy
        run: mypy app/backend tests/e2e-ui

  gitleaks-secrets:
    name: Secrets Check (Gitleaks)
    runs-on: ubuntu-latest
    needs: code-quality
    steps:
      - uses: actions/checkout@v3
      - name: Install Gitleaks
        run: curl -sSfL https://raw.githubusercontent.com/zricethezav/gitleaks/main/install.sh | bash
      - name: Run Gitleaks
        run: gitleaks detect --source=app/backend --verbose

  semgrep-sast:
    name: SAST Tests Code (Semgrep)
    runs-on: ubuntu-latest
    needs: gitleaks-secrets
    steps:
      - uses: actions/checkout@v3
      - name: Install Semgrep
        run: pip install semgrep
      - name: Run Semgrep
        run: semgrep --config=auto app/backend tests/e2e-ui

  trivy-fs:
    name: Repo Security (Trivy FS)
    runs-on: ubuntu-latest
    needs: semgrep-sast
    steps:
      - uses: actions/checkout@v3
      - name: Install Trivy
        run: |
          sudo apt-get update
          sudo apt-get install -y wget
          wget https://github.com/aquasecurity/trivy/releases/latest/download/trivy_0.46.0_Linux-64bit.deb
          sudo dpkg -i trivy_0.46.0_Linux-64bit.deb
      - name: Run Trivy FS scan
        run: trivy fs app/backend app/frontend tests/e2e-ui

  pull-images:
    name: Pull Backend and Frontend Images
    runs-on: ubuntu-latest
    needs: trivy-fs
    steps:
      - name: Pull Backend Image
        run: docker pull ghcr.io/${{ github.repository }}/backend:${{ github.sha }}
      - name: Pull Frontend Image
        run: docker pull ghcr.io/${{ github.repository }}/frontend:${{ github.sha }}

  deploy-and-test-stack:
    name: Deploy and Test Stack (E2E UI + DAST)
    runs-on: ubuntu-latest
    needs: pull-images
    steps:
      - uses: actions/checkout@v3

      - name: Setup Docker Compose
        run: sudo apt-get install -y docker-compose

      - name: Deploy Staging Stack
        run: docker-compose -f tests/e2e-ui/docker-compose.staging.yml up -d

      - name: Run E2E UI Tests
        run: pytest tests/e2e-ui --junitxml=e2e-ui-results.xml

      - name: OWASP ZAP Full Scan
        run: |
          docker run --rm -t owasp/zap2docker-stable zap-full-scan.py \
          -t http://localhost:8080 -r zap-full-report.html

      - name: Teardown Staging Stack
        run: docker-compose -f tests/e2e-ui/docker-compose.staging.yml down

  url-fuzzing:
    name: URL Fuzzing (FFuf)
    runs-on: ubuntu-latest
    needs: deploy-and-test-stack
    steps:
      - uses: actions/checkout@v3
      - name: Install FFuf
        run: sudo apt-get install -y ffuf
      - name: Run FFuf
        run: ffuf -w tests/e2e-ui/fuzz/wordlist.txt -u http://localhost:8080/FUZZ